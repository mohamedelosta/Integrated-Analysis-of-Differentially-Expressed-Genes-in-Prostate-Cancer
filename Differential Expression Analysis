# 1. Sample type filteration & dds creation ==============================================================================

# Filter to include only normal and tumor samples
samples_to_keep <- phenoData[[shortCodeLetter]] %in% c(normal_label, tumor_label)
  
count_data_filtered <- count_data[, samples_to_keep]
phenoData_filtered <- phenoData[samples_to_keep, ]
  
# Set factor levels 
phenoData_filtered[[shortCodeLetter]] <- factor(
  phenoData_filtered[[shortCodeLetter]],
  levels = c('NT', 'TP')
)
  
  
# Create DESeq2 dataset
dds <- DESeqDataSetFromMatrix(
  countData = count_data_filtered,
  colData = phenoData_filtered,
  design = as.formula(paste("~", condition_column))
)





# 2. RUN DIFFERENTIAL EXPRESSION ANALYSIS ==============================================================================

  dds_run <- DESeq(dds)
  
  # Extract results with contrast
  res <- results(
    dds_run,
    contrast = c("sample_type", tumor_label, normal_label),
    alpha = padj_threshold
  )
  
  # Convert to data frame
  res_df <- as.data.frame(res)
  
  # Identify DEGs
  degs <- res[res$padj <  0.01 & abs(res$log2FoldChange) > log2(3), ]
  degs <- degs[order(degs$padj), ]
  
  
  return(list(
    dds = dds_run,
    results = res,
    results_df = res_df,
    degs = degs,
    deg_genes = rownames(degs)
  ))
}




