# 7. 2D PCA PLOT ==============================================================================

create_2d_pca <- function(degs_exp, metadata, output_dir = "plots") {
  

  # Perform PCA
  pca_result <- prcomp(t(degs_exp), scale. = TRUE)
  
  # Calculate variance explained
  var_explained <- summary(pca_result)$importance[2, 1:2] * 100
  
  # Create data frame for plotting
  pca_df <- as.data.frame(pca_result$x[, 1:2])
  pca_df$sample_type <- metadata$sample_type
  
  # Define colors
  sample_type_colors <- c("Primary Tumor" = "red", "Solid Tissue Normal" = "green3")
  
  # Create plot
  p <- ggplot(pca_df, aes(x = PC1, y = PC2, color = sample_type)) +
    geom_point(size = 3, alpha = 0.7) +
    scale_color_manual(values = sample_type_colors) +
    theme_minimal() +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      legend.title = element_text(face = "bold"),
      legend.position = "right"
    ) +
    labs(
      title = "2D PCA: Primary Tumor vs Normal",
      x = paste0("PC1 (", round(var_explained[1], 2), "% variance)"),
      y = paste0("PC2 (", round(var_explained[2], 2), "% variance)"),
      color = "Sample Type"
    ) +
    stat_ellipse(aes(group = sample_type), type = "norm", level = 0.95)
  
  # Save plot
  ggsave(
    file.path(output_dir, "pca_2d_plot.png"),
    plot = p,
    width = 10,
    height = 8,
    dpi = 300
  )
  
  return(list(plot = p, pca = pca_result))
}

# Create 2D PCA
pca_2d <- create_2d_pca(normalized_data$degs_normalized, colData)

print(pca_2d$plot)


# 8. 3D PCA PLOT (INTERACTIVE) ==============================================================================

create_3d_pca <- function(degs_exp, metadata, output_dir = "plots") {
  
  # Perform PCA
  pca_result <- prcomp(t(degs_exp), scale. = TRUE)
  pca_df <- as.data.frame(pca_result$x[, 1:3])
  pca_df$sample_type <- metadata$sample_type
  
  # Calculate variance explained
  var_explained <- summary(pca_result)$importance[2, 1:3] * 100
  
  # Define colors
  colors <- ifelse(pca_df$sample_type == "Primary Tumor", "red", "green")
  
  # Create 3D plot
  p <- plot_ly(
    data = pca_df,
    x = ~PC1,
    y = ~PC2,
    z = ~PC3,
    color = ~sample_type,
    colors = c("green", "red"),
    type = "scatter3d",
    mode = "markers",
    marker = list(size = 5, opacity = 0.7),
    text = ~paste(
      "Sample Type:", sample_type,
      "<br>PC1:", round(PC1, 2),
      "<br>PC2:", round(PC2, 2),
      "<br>PC3:", round(PC3, 2)
    ),
    hoverinfo = "text"
  ) %>%
    layout(
      title = list(
        text = "3D PCA Plot: Primary Tumor vs Normal",
        font = list(size = 16, face = "bold")
      ),
      scene = list(
        xaxis = list(title = paste0("PC1 (", round(var_explained[1], 2), "%)")),
        yaxis = list(title = paste0("PC2 (", round(var_explained[2], 2), "%)")),
        zaxis = list(title = paste0("PC3 (", round(var_explained[3], 2), "%)"))
      ),
      legend = list(title = list(text = "Sample Type"))
    )
  
  # Save as HTML
  htmlwidgets::saveWidget(
    p,
    file.path(output_dir, "pca_3d_plot.html"),
    selfcontained = TRUE
  )
  return(p)
}

