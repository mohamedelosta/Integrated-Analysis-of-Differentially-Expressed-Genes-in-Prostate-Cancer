## 6. HEATMAP OF TOP DEGs ==============================================================================

create_deg_heatmap <- function(degs_exp, degs_results, metadata, 
                              top_n = 500, output_dir = "plots") {

  # Select top N DEGs based on adjusted p-value
  top_degs_idx <- order(degs_results$padj)[1:min(top_n, nrow(degs_results))]
  top_degs_exp <- degs_exp[top_degs_idx, ]

  # Filter metadata for relevant samples
  metadata_filtered <- phenoData[phenoData$sample_type %in% 
                                c("Primary Tumor", "Solid Tissue Normal"), ]
  
  # Define colors
  sample_type_colors <- c("Primary Tumor" = "red", "Solid Tissue Normal" = "green")
  
  # Create column annotation
  column_ha <- HeatmapAnnotation(
    Sample_Type = phenoData_filtered$sample_type,
    col = list(Sample_Type = sample_type_colors),
    annotation_name_gp = gpar(fontsize = 10),
    annotation_legend_param = list(
      Sample_Type = list(title = "Sample Type")
    )
  )
  
  # Z-score normalization
  mat_scaled <- t(scale(t(top_degs_exp)))
  
  # Create heatmap
  ht <- Heatmap(
    mat_scaled,
    name = "Z-score",
    top_annotation = column_ha,
    column_split = phenoData_filtered$sample_type,
    cluster_columns = TRUE,
    cluster_rows = TRUE,
    show_row_names = ifelse(nrow(mat_scaled) <= 100, TRUE, FALSE),
    show_column_names = FALSE,
    row_names_gp = gpar(fontsize = 6),
    column_title_gp = gpar(fontsize = 12, fontface = "bold"),
    heatmap_legend_param = list(
      title = "Expression\n(Z-score)",
      legend_height = unit(4, "cm")
    ),
    col = colorRamp2(c(-2, 0, 2), c("blue", "white", "red")),
    use_raster = TRUE,
    raster_quality = 2
  )
  
  # Save heatmap
  png(
    file.path(output_dir, "deg_heatmap_top500.png"),
    width = 12,
    height = 10,
    units = "in",
    res = 300
  )
  draw(ht)
  dev.off()
  
  cat("Heatmap saved to:", file.path(output_dir, "deg_heatmap_top500.png"), "\n\n")
  
  return(ht)
}

