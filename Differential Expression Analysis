# 10. SUMMARY REPORT ==============================================================================

generate_summary_report <- function(de_results, output_dir = "results") {
  
  cat(rep("=", 70), "\n", sep = "")
  cat("SUMMARY REPORT\n")
  cat(rep("=", 70), "\n\n", sep = "")
  
  # Create summary statistics
  summary_stats <- data.frame(
    Metric = c(
      "Total genes tested",
      "Significant DEGs (padj < 0.01, |log2FC| > log2(3))",
      "Upregulated in tumor",
      "Downregulated in tumor",
      "Percentage upregulated",
      "Percentage downregulated",
      "Top upregulated gene",
      "Top downregulated gene"
    ),
    Value = c(
      nrow(de_results$results),
      nrow(de_results$degs),
      sum(de_results$degs$log2FoldChange > 0),
      sum(de_results$degs$log2FoldChange < 0),
      paste0(round(100 * sum(de_results$degs$log2FoldChange > 0) / nrow(de_results$degs), 2), "%"),
      paste0(round(100 * sum(de_results$degs$log2FoldChange < 0) / nrow(de_results$degs), 2), "%"),
      rownames(de_results$degs)[which.max(de_results$degs$log2FoldChange)],
      rownames(de_results$degs)[which.min(de_results$degs$log2FoldChange)]
    )
  )
  
  # Save summary
  write.csv(
    summary_stats,
    file.path(output_dir, "analysis_summary.csv"),
    row.names = FALSE
  )
  
  # Print summary
  cat("Analysis Summary:\n")
  print(summary_stats, row.names = FALSE)
  cat("\n")
  
  cat("Summary saved to:", file.path(output_dir, "analysis_summary.csv"), "\n\n")
  
  return(summary_stats)
}

# Generate summary report
summary_report <- generate_summary_report(de_results)


