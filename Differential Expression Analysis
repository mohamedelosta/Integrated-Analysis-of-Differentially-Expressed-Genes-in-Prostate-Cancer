# 5. VOLCANO PLOT ==============================================================================


create_volcano_plot <- function(results_df, padj_cutoff = 0.01, 
                               lfc_cutoff = 1.5, output_dir = "plots") {
  

  
# Create output directory
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
  
# Define colors based on significance
keyvals <- ifelse(
  results_df$log2FoldChange < -lfc_cutoff & results_df$padj < padj_cutoff, "green4",
  ifelse(results_df$log2FoldChange > lfc_cutoff & results_df$padj < padj_cutoff, "red3",
          "grey30")
)
keyvals[is.na(keyvals)] <- "grey30"
names(keyvals)[keyvals == "red3"] <- "Upregulated"
names(keyvals)[keyvals == "grey30"] <- "Not significant"
names(keyvals)[keyvals == "green4"] <- "Downregulated"
  
# Create volcano plot
p <- EnhancedVolcano(
  results_df,
  lab = rownames(results_df),
  x = "log2FoldChange",
  y = "padj",
  title = "Volcano Plot: Primary Tumor vs Normal",
  subtitle = paste0("padj < ", padj_cutoff, ", |log2FC| > ", lfc_cutoff),
  colCustom = keyvals,
  pCutoff = padj_cutoff,
  FCcutoff = lfc_cutoff,
  pointSize = 2.0,
  labSize = 4.0,
  col = c("grey30", "grey30", "green4", "red3"),
  colAlpha = 0.7,
  legendPosition = "right",
  legendLabSize = 12,
  legendIconSize = 4.0,
  drawConnectors = TRUE,
  widthConnectors = 0.5,
  max.overlaps = 20
)
  
# Save plot
ggsave(
  file.path(output_dir, "volcano_plot.png"),
  plot = p,
  width = 12,
  height = 10,
  dpi = 300
)
  
return(p)
}

# Create volcano plot
volcano_plot <- create_volcano_plot(
