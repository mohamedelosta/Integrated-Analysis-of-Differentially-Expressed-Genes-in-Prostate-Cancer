make_predictions <- function(models, xgb_model, test_data) {
  cat("\n", rep("=", 50), "\n", sep = "")
  cat("MAKING PREDICTIONS\n")
  cat(rep("=", 50), "\n", sep = "")
  
  # Traditional ML predictions (probabilities)
  pred_rf <- predict(models$rf, newdata = test_data, type = "prob")[, 2]
  pred_svm <- predict(models$svmRadial, newdata = test_data, type = "prob")[, 2]
  
  # XGBoost predictions
  test_matrix <- as.matrix(test_data[, -ncol(test_data)])
  pred_xgb <- predict(xgb_model, test_matrix)
  
  predictions <- list(
    rf = pred_rf,
    svm = pred_svm,
    xgb = pred_xgb
  )
  
  return(predictions)
}

