# 2. DATA SPLITTING ==============================================================================

split_data <- function(data, train_prop = 0.7, test_prop = 0.2, val_prop = 0.1) {
  # Validate proportions
  if(train_prop + test_prop + val_prop != 1) {
    stop("Proportions must sum to 1")
  }
  
  # First split: training vs (test + validation)
  train_idx <- createDataPartition(data$class, times = 1, p = train_prop, list = FALSE)
  train_data <- data[train_idx, ]
  remaining_data <- data[-train_idx, ]
  
  # Second split: test vs validation
  test_proportion <- test_prop / (test_prop + val_prop)
  test_idx <- createDataPartition(remaining_data$class, times = 1, 
                                  p = test_proportion, list = FALSE)
  test_data <- remaining_data[test_idx, ]
  val_data <- remaining_data[-test_idx, ]
  
  cat("\nData split summary:\n")
  cat("Training samples:", nrow(train_data), "\n")
  cat("Test samples:", nrow(test_data), "\n")
  cat("Validation samples:", nrow(val_data), "\n")
  
  return(list(train = train_data, test = test_data, validation = val_data))
}

