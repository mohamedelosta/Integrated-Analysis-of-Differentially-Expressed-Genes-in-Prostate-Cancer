# ==============================================================================
# 8. DEEP LEARNING WITH H2O
# ==============================================================================

train_deep_learning <- function(train_data, validation_data, test_data, 
                               epochs = 100, hidden = c(200, 200, 200)) {
  
  cat("\n", rep("=", 50), "\n", sep = "")
  cat("TRAINING DEEP LEARNING MODEL (H2O)\n")
  cat(rep("=", 50), "\n", sep = "")
  
  # Initialize H2O
  h2o.init(nthreads = -1, max_mem_size = "8G")
  
  # Convert to H2O frames
  train_h2o <- as.h2o(train_data)
  validation_h2o <- as.h2o(validation_data)
  test_h2o <- as.h2o(test_data)
  
  # Get feature and response column names
  response <- "class"
  predictors <- setdiff(names(train_data), response)
  
  # Train deep learning model
  dl_model <- h2o.deeplearning(
    x = predictors,
    y = response,
    training_frame = train_h2o,
    validation_frame = validation_h2o,
    epochs = epochs,
    hidden = hidden,
    activation = "RectifierWithDropout",
    input_dropout_ratio = 0.2,
    hidden_dropout_ratios = c(0.5, 0.5, 0.5),
    stopping_rounds = 5,
    stopping_metric = "AUC",
    stopping_tolerance = 0.001,
    score_each_iteration = TRUE,
    variable_importances = TRUE,
    seed = 123
  )
  
  # Model summary
  print(dl_model)
  
  # Predictions on test set
  dl_predictions <- h2o.predict(dl_model, test_h2o)
  
  # Performance on test set
  dl_performance <- h2o.performance(dl_model, test_h2o)
  print(dl_performance)
  
  # Plot performance
  plot(dl_performance)
  
  # Variable importance plot
  h2o.varimp_plot(dl_model, num_of_features = 20)
  
  results <- list(
    model = dl_model,
    predictions = as.data.frame(dl_predictions),
    performance = dl_performance,
    auc = h2o.auc(dl_performance)
  )
  
  return(results)
}

# Train deep learning model
dl_results <- train_deep_learning(
  train_data = train,
  validation_data = validation,
  test_data = test,
  epochs = 100,
  hidden = c(200, 200, 200)
)

