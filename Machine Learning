# 6. MODEL EVALUATION ==============================================================================

evaluate_models <- function(predictions, test_labels) {

  # Convert labels to numeric (0/1)
  test_numeric <- as.numeric(test_labels) - 1
  
  # Calculate ROC curves
  roc_rf <- roc(test_numeric, predictions$rf, levels = c(0, 1), direction = "<")
  roc_svm <- roc(test_numeric, predictions$svm, levels = c(0, 1), direction = "<")
  roc_xgb <- roc(test_numeric, predictions$xgb, levels = c(0, 1), direction = "<")
  
  # Get AUC values
  auc_rf <- auc(roc_rf)
  auc_svm <- auc(roc_svm)
  auc_xgb <- auc(roc_xgb)
  
  cat("AUC Scores:\n")
  cat("Random Forest:", round(auc_rf, 4), "\n")
  cat("SVM:", round(auc_svm, 4), "\n")
  cat("XGBoost:", round(auc_xgb, 4), "\n")
  
  # Calculate confusion matrices (using 0.5 threshold)
  pred_rf_class <- factor(ifelse(predictions$rf > 0.5, 1, 0), levels = c(0, 1))
  pred_svm_class <- factor(ifelse(predictions$svm > 0.5, 1, 0), levels = c(0, 1))
  pred_xgb_class <- factor(ifelse(predictions$xgb > 0.5, 1, 0), levels = c(0, 1))
  
  test_factor <- factor(test_numeric, levels = c(0, 1))
  
  cm_rf <- confusionMatrix(pred_rf_class, test_factor, positive = "1")
  cm_svm <- confusionMatrix(pred_svm_class, test_factor, positive = "1")
  cm_xgb <- confusionMatrix(pred_xgb_class, test_factor, positive = "1")
  
  # Compile metrics
  metrics <- data.frame(
    Model = c("Random Forest", "SVM", "XGBoost"),
    AUC = c(auc_rf, auc_svm, auc_xgb),
    Accuracy = c(cm_rf$overall["Accuracy"], 
                 cm_svm$overall["Accuracy"], 
                 cm_xgb$overall["Accuracy"]),
    Sensitivity = c(cm_rf$byClass["Sensitivity"], 
                   cm_svm$byClass["Sensitivity"], 
                   cm_xgb$byClass["Sensitivity"]),
    Specificity = c(cm_rf$byClass["Specificity"], 
                   cm_svm$byClass["Specificity"], 
                   cm_xgb$byClass["Specificity"]),
    Balanced_Accuracy = c(cm_rf$byClass["Balanced Accuracy"], 
                         cm_svm$byClass["Balanced Accuracy"], 
                         cm_xgb$byClass["Balanced Accuracy"]),
    F1 = c(cm_rf$byClass["F1"], 
           cm_svm$byClass["F1"], 
           cm_xgb$byClass["F1"])
  )
  
  print(metrics)
  
  results <- list(
    roc = list(rf = roc_rf, svm = roc_svm, xgb = roc_xgb),
    metrics = metrics,
    confusion_matrices = list(rf = cm_rf, svm = cm_svm, xgb = cm_xgb)
  )
  
  return(results)
}

# Evaluate models
evaluation_results <- evaluate_models(predictions, test$class)


