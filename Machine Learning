prepare_data <- function(degs_exp, col_data) {
  # Transpose expression data and add class labels
  deg_train <- as.data.frame(t(degs_exp))
  deg_train$class <- factor(make.names(col_data$sample_type))
  
  # Check for missing values
  if(any(is.na(deg_train))) {
    warning("Missing values detected. Consider imputation.")
  }
  
  return(deg_train)
}

