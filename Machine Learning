train_ml_models <- function(train_data, algorithms = c('rf', 'svmRadial')) {
  # Define training control
  train_control <- trainControl(
    method = "repeatedcv",
    number = 10,
    repeats = 3,
    classProbs = TRUE,
    summaryFunction = twoClassSummary,
    savePredictions = "final",
    verboseIter = FALSE
  )
  
  cat("\nTraining models:", paste(algorithms, collapse = ", "), "\n")
  
  # Train models
  models <- caretList(
    class ~ .,
    data = train_data,
    methodList = algorithms,
    trControl = train_control,
    metric = "ROC"
  )
  
  return(models)
}

