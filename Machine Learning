# 7.3 Feature Importance (Random Forest)
plot_feature_importance <- function(model, top_n = 20) {
  importance_scores <- varImp(model)$importance
  importance_df <- data.frame(
    Feature = rownames(importance_scores),
    Importance = importance_scores$Overall
  )
  importance_df <- importance_df[order(-importance_df$Importance), ]
  top_features <- head(importance_df, top_n)
  
  p <- ggplot(top_features, aes(x = reorder(Feature, Importance), y = Importance)) +
    geom_bar(stat = "identity", fill = "steelblue") +
    coord_flip() +
    theme_minimal() +
    labs(title = paste("Top", top_n, "Important Features (Random Forest)"),
         x = "Features", y = "Importance Score") +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))
  
  print(p)
  
  return(top_features)
}

