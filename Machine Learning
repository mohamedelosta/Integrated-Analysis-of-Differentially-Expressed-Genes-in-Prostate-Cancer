save_results <- function(models, xgb_model, dl_model, metrics, top_genes, 
                        output_dir = "ml_results") {
  
  # Create output directory
  if(!dir.exists(output_dir)) {
    dir.create(output_dir, recursive = TRUE)
  }
  
  # Save models
  saveRDS(models, file.path(output_dir, "ml_models.rds"))
  saveRDS(xgb_model, file.path(output_dir, "xgb_model.rds"))
  h2o.saveModel(dl_model, path = output_dir, force = TRUE)
  
  # Save metrics
  write.csv(metrics, file.path(output_dir, "model_metrics.csv"), row.names = FALSE)
  
  # Save top genes
  write.csv(top_genes, file.path(output_dir, "top_important_genes.csv"), row.names = FALSE)
  
  cat("\nResults saved to:", output_dir, "\n")
}

